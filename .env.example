# Copy to Netlify UI: Site settings → Environment variables
# (Local: copy to .env for `netlify dev`)

# GM filter (must match sheet column exactly)
GM_NAME=Siddhartha

# Comma-separated team leads for this GM
MANAGERS=Adnan,Sudhanshu,Shailendra,Bhavya

# Payment sheet month number (May = 5)
PAYMENT_MONTH=5
DEFAULT_TOKEN_AMOUNT=5000
UNASSIGNED_TL=Unassigned

# Optional date fallbacks when sheet has no rows
MONTH_START=2026-05-01
MONTH_END=2026-05-31

# Google Sheets published CSV URLs
LEADS_CSV_URL=https://docs.google.com/spreadsheets/d/e/2PACX-1vS6sKBGja2Ugu8eLACnO7mbztHeHGR9Xig_CE_FsnjETYVbeKO2nXi9uRXp54Tioyc4E96xDtJe780Y/pub?gid=0&single=true&output=csv
INPUTS_CSV_URL=https://docs.google.com/spreadsheets/d/e/2PACX-1vT6_Ukl-_qTeyobt1Q3SpgXhR0921qgUWrz6WPnINvl3U2OXl1dcsjEyGgMafUmG_cb9rE6QNrWZkuX/pub?gid=948739317&single=true&output=csv
TOKENS_CSV_URL=https://docs.google.com/spreadsheets/d/e/2PACX-1vTcztb-A37i4VXvWKnATdaFrGPZGf5tQlsYIDgdb7CViBh_TpL0kdst-OVwlEBxISLK1fHob_G86ffr/pub?gid=0&single=true&output=csv
FULLPAYMENTS_CSV_URL=https://docs.google.com/spreadsheets/d/e/2PACX-1vTcztb-A37i4VXvWKnATdaFrGPZGf5tQlsYIDgdb7CViBh_TpL0kdst-OVwlEBxISLK1fHob_G86ffr/pub?gid=703953175&single=true&output=csv

# Serverless cache TTL (minutes) — refreshes sheet data periodically
CACHE_TTL_MINUTES=4
REQUEST_TIMEOUT=30
